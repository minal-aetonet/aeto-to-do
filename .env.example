# Copy this file to ".env" and change the values if you need to.
# The real .env file is ignored by git so secrets never get committed.

# The port the web server listens on. Open http://localhost:3000
PORT=3000

# Where the SQLite database file is stored (created automatically).
DATABASE_PATH=./data/todo.db

# Print one line per HTTP request to the terminal (true or false).
LOG_REQUESTS=true

# Only send the login cookie over HTTPS. Keep "false" on http://localhost,
# set to "true" in production where the site uses https://.
COOKIE_SECURE=false
